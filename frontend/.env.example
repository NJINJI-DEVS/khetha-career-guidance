# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# Supabase project settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# The ASP.NET Core API, running locally via `dotnet watch run`
VITE_API_BASE_URL=http://localhost:56878

# --- Demo administrator shortcut (OPTIONAL, and off by default) ---------------
# Typing admin / njinji on the administrator sign-in screen signs in as the real
# account named here. Convenient for a live demo; NOT a second way in - that
# account still has to be an active row in the admins table.
#
# WARNING: Vite inlines VITE_* variables into the JavaScript bundle at build
# time. A build made with these set ships a working administrator password that
# anyone can read in devtools. Leave them unset for anything public, and rotate
# the password afterwards if you ever set them.
VITE_ENABLE_DEMO_ADMIN=false
VITE_DEMO_ADMIN_EMAIL=
VITE_DEMO_ADMIN_PASSWORD=
